#include <nuttx/config.h>

set +e

#include "rcS.first"

#ifdef CONFIG_FS_HOSTFS
mount -t hostfs -o fs=./out/boot_path/ /host
#endif

#ifdef CONFIG_FS_V9FS
mount -t v9fs -o trans=virtio,tag=host  /share
#endif

#include "rcS.last"

#ifdef CONFIG_VELA_BL
boot /host/vela_core0_user.elf
boot /host/vela_core0.elf
#endif

#if defined(CONFIG_RPTUN_BMP) || defined(CONFIG_RPMSG_VIRTIO_BMP)
    #ifdef CONFIG_BUILD_PROTECTED
        boot /host/vela_core1_user.elf
        boot /host/vela_core2_user.elf
        boot /host/vela_core3_user.elf
        boot /host/vela_core4_user.elf
    #endif
    boot /host/vela_core1.elf
    boot /host/vela_core2.elf
    boot /host/vela_core3.elf
    boot /host/vela_core4.elf
#endif
